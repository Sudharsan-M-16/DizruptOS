# ============================================================
# DIZRUPT — environment template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it contains secrets.
# ============================================================

# ── Supabase (required for real auth + persistence) ─────────
# Get all values from: Supabase dashboard → Project Settings → API

# Project URL — looks like: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon (public) key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SERVER ONLY, never put in browser code or commit
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database connection string — MUST use "Session pooler" URI (IPv4, port 5432)
# Found at: Supabase → Project Settings → Database → Connection string → Session pooler
# Format:   postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# WARNING:  The direct db.*.supabase.co:5432 URI is IPv6-only and will fail on most hosts
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── App URL ─────────────────────────────────────────────────
# Full public URL of this deployment. Used for OAuth redirects + invite emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── AI Copilot (optional) ───────────────────────────────────
# Without this the Copilot uses deterministic answers (still works, just less impressive).
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Error tracking (optional) ───────────────────────────────
# Get from: sentry.io → Projects → your project → Client Keys
SENTRY_DSN=https://YOUR_KEY@oXXXXXXX.ingest.sentry.io/YYYYYYY

# ── Webhook secrets (optional, recommended for production) ──
# These authenticate inbound webhooks from each integration.
# Set the same value in both this file AND the integration's webhook config.
# Without them the connectors run in open mode (anyone can POST to the URL).
JIRA_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
LINEAR_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# ── CORS (optional) ─────────────────────────────────────────
# Comma-separated list of additional origins allowed to call the API.
# The app's own origin is always allowed. Only needed for mobile apps or
# third-party integrations calling the API from a different domain.
# CORS_ALLOWED_ORIGINS=https://mobile.yourdomain.com,https://partner.example.com

# ── Observability (optional) ────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
