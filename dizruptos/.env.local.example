# ============================================================
# DIZRUPT — environment template
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Get all four values from: Supabase dashboard → Project Settings → API

# Project URL — looks like: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon (public) key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SERVER ONLY, never put in browser code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database connection string — use "Session pooler" URI (IPv4, port 5432)
# Found at: Project Settings → Database → Connection string → Session pooler
# Format:   postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── AI (optional) ───────────────────────────────────────────
# Without this key the Copilot uses deterministic fallback (still works).
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── App ─────────────────────────────────────────────────────
NEXTAUTH_SECRET=any-random-32-char-string-here
NEXTAUTH_URL=http://localhost:3000
