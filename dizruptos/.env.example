# DIZRUPT environment template
# Copy to .env.local — NEVER commit real values (gitignored).
#
# With nothing set, the app boots in DEMO MODE: full UI on the in-memory seed
# organization, persona auth, cross-tab realtime. That is the supported way to
# run it today.

# --- Supabase (enables production persistence; set BOTH or NEITHER) ---------
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-side only — used by API routes and the Railway worker. NEVER prefix
# with NEXT_PUBLIC_, never import into client components.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- AI providers (worker + /ai/search; optional, features degrade gracefully)
# ANTHROPIC_API_KEY=<key>     # summaries, meeting extraction, risk prediction
# OPENAI_API_KEY=<key>        # text-embedding-3-small embeddings

# --- Observability (optional) ------------------------------------------------
# SENTRY_DSN=<dsn>
