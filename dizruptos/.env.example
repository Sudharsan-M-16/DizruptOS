# DIZRUPT environment template
# Copy to .env.local — NEVER commit real values (gitignored).
#
# With nothing set, the app boots in DEMO MODE: full UI on the in-memory seed
# organization, persona auth, cross-tab realtime. That is the supported way to
# run it today.

# ── Supabase (enables live persistence) ──────────────────────────────────────
# Set BOTH or NEITHER — half-configured throws an error at boot.
# Use Session Pooler for DATABASE_URL (IPv4 compatible; direct db.* is IPv6-only).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# SESSION_SECRET=change-me-in-production

# ── AI (optional — copilot degrades to deterministic if unset) ───────────────
# When set, the Copilot uses Claude claude-sonnet-4-6 for fluent, grounded answers.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Enterprise: SCIM provisioning ────────────────────────────────────────────
# IdPs send this token in Authorization: Bearer <token>
# SCIM_TOKEN=<random-secret>

# ── Enterprise: SSO (per-tenant JSON blobs) ───────────────────────────────────
# SSO_CONFIG_<ORG_SLUG_UPPERCASE>={"protocol":"saml","idpSsoUrl":"...","idpEntityId":"..."}
# SSO_CONFIG_ACME={"protocol":"saml","idpSsoUrl":"https://acme.okta.com/..."}

# ── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=<dsn>
# METRICS_TOKEN=<secret>   # Prometheus scrape auth (open if unset in demo)

# ── Application URL ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://app.dizrupt.com
